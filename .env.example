APP_NAME="Bahuchar Bike Care"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production (HTTPS): SESSION_SECURE_COOKIE=true and SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# sync = instant jobs for local free SMS testing. Production: database + php artisan queue:work
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# API / Sanctum (Android apps)
SANCTUM_TOKEN_EXPIRATION=43200
CORS_ALLOWED_ORIGINS=*

# MSG91 SMS (India) — FREE MODE: keep MSG91_ENABLED=false (log only, no credits)
# Production: set MSG91_ENABLED=true after DLT approval
MSG91_ENABLED=false
MSG91_AUTH_KEY=
MSG91_CONFIRMATION_TEMPLATE_ID=
MSG91_REMINDER_TEMPLATE_ID=
MSG91_SHOP_PHONE="+91 9824799203"

# Customer messaging (free options)
# WhatsApp = click-to-send links (always free). Email uses MAIL_* settings below.
MESSAGING_WHATSAPP_ENABLED=true
MESSAGING_EMAIL_ENABLED=true

SHOP_NAME="Bahuchar Bike Care"
SHOP_ADDRESS="Shop No. 7, Bahuchar Auto Care, near Vishwas City 3, Vandematram, Gota, Ahmedabad - 382481"
SHOP_PHONE="9824799203"
SHOP_GSTIN=
SHOP_BILL_PREFIX=BBC
SHOP_TAGLINE="Trusted bike service & care in your neighbourhood"
SHOP_HOURS="Mon – Sat: 8:30 AM – 8:30 PM | Sunday: 8:30 AM – 3:00 PM"

# Monthly data backup (runs 1st of each month at 2:00 AM IST via `php artisan schedule:work`)
BACKUP_KEEP_MONTHS=12

# ---------------------------------------------------------------------------
# Production checklist (see deploy/DEPLOYMENT.md and deploy/.env.production.example)
# - APP_ENV=production, APP_DEBUG=false, APP_URL=https://yourdomain.com
# - QUEUE_CONNECTION=database + Supervisor queue worker
# - SESSION_SECURE_COOKIE=true, SESSION_ENCRYPT=true
# - LOG_LEVEL=error
# - Do NOT deploy on Netlify or Vercel (static/Node hosts; needs PHP + MySQL VPS)
# ---------------------------------------------------------------------------
