APP_NAME="Bahuchar Bike Care"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yourdomain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bahuchar_bike_care
DB_USERNAME=bahuchar
DB_PASSWORD=change-me-strong-password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

SANCTUM_TOKEN_EXPIRATION=43200
CORS_ALLOWED_ORIGINS=https://yourdomain.com

MSG91_ENABLED=false
MSG91_AUTH_KEY=
MSG91_CONFIRMATION_TEMPLATE_ID=
MSG91_REMINDER_TEMPLATE_ID=
MSG91_SHOP_PHONE="+91 9824799203"

MESSAGING_WHATSAPP_ENABLED=true
MESSAGING_EMAIL_ENABLED=true

SHOP_NAME="Bahuchar Bike Care"
SHOP_ADDRESS="Shop No. 7, Bahuchar Auto Care, near Vishwas City 3, Vandematram, Gota, Ahmedabad - 382481"
SHOP_PHONE="9824799203"
SHOP_GSTIN=
SHOP_BILL_PREFIX=BBC
SHOP_TAGLINE="Trusted bike service & care in your neighbourhood"
SHOP_HOURS="Mon – Sat: 8:30 AM – 8:30 PM | Sunday: 8:30 AM – 3:00 PM"

BACKUP_KEEP_MONTHS=12
